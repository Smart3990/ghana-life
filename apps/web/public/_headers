# Map tiles: give them their real type so Cloudflare compresses them,
# and let phones cache them for a day.
/tiles/*
  Content-Type: application/x-protobuf
  Cache-Control: public, max-age=86400

# Map fonts and icons rarely change.
/map/fonts/*
  Content-Type: application/x-protobuf
  Cache-Control: public, max-age=604800
/map/sprites/*
  Cache-Control: public, max-age=604800

# Street and traffic data: rebuilt rarely.
/data/*
  Cache-Control: public, max-age=86400

# The service worker must always be fresh, so updates reach phones.
/sw.js
  Cache-Control: no-cache

# The owner's Accra sound recordings: rebuilt rarely.
/sounds/*
  Cache-Control: public, max-age=604800
