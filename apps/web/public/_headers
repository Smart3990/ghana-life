# Map tiles: give them their real type so Cloudflare compresses them,
# and let phones cache them for a day.
/tiles/*
  Content-Type: application/x-protobuf
  Cache-Control: public, max-age=86400

# Map fonts and icons rarely change.
/map/fonts/*
  Content-Type: application/x-protobuf
  Cache-Control: public, max-age=604800
/map/sprites/*
  Cache-Control: public, max-age=604800
