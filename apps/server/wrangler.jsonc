{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ghana-life-server",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "PingRoom" }]
  },
  // The free plan needs SQLite-backed Durable Objects.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["PingRoom"] }]
}
